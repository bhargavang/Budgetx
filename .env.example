# Copy to .env and fill in. docker compose reads .env automatically; never commit .env.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USERNAME=budgetx
MYSQL_PASSWORD=change-me
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=
# Optional: turns on AI-personalised guidance (https://console.anthropic.com). Empty = rules-only.
ANTHROPIC_API_KEY=
# claude-opus-5-5 is the default; claude-haiku-5-5 is much cheaper if cost matters.
ANTHROPIC_MODEL=claude-opus-5-5
# AI calls per user per 24 hours; after that guidance is rules-only.
AI_DAILY_LIMIT_PER_USER=5
ALPHAVANTAGE_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Host port for the web app (nginx). Use 80 on a server so it opens at http://<ip>/
FRONTEND_PORT=3000
